+export const PLANT_PURCHASE_EMAIL_SUBJECT =
+  "🎉 تم تأكيد طلبك - دليل إنقاذ ورعاية النباتات المنزلية";
+
+export function buildPlantPurchaseEmail(input: {
+  name?: string;
+  deliveryUrl: string;
+  whatsappDisplay: string;
+}) {
+  const link = input.deliveryUrl.trim();
+  const whatsapp = input.whatsappDisplay || "01017420379";
+  const accessBlock = link
+    ? `🌱 لينك الدخول على الدليل:
+
+${link}
+
+افتح اللينك من الموبايل أو الكمبيوتر، والدليل شغال بالعربي ومن اليمين لليسار.`
+    : `🌱 لينك الدخول هيبعتلك كمان على واتساب لو مش ظاهر هنا. تواصل على ${whatsapp} برقم الطلب.`;
+
+  const text = `أهلًا بيك 👋
+مبروك! 🎉
+تم تأكيد طلبك بنجاح، ودلوقتي تقدر تستخدم دليل إنقاذ ورعاية النباتات المنزلية.
+
+${accessBlock}
+
+🌿 إيه المنتج اللي اشتريته؟
+
+ده دليل تفاعلي (مش كورس فيديو ومش اشتراك شهري). تدفع مرة واحدة، وتدخل على الموقع وتستخدم الأدوات على طول.
+
+الدليل معمول للبيت المصري: نباتات بتتتباع في المشاتل هنا، تسميات الناس بتستخدمها، وخلطات تربة من مواد موجودة في السوق المصري.
+
+✅ هتلاقي إيه جوه الدليل؟
+
+1) دليل 77 نبات من السوق المصري
+كل نبات عليه كارت فيه صورة حقيقية عشان تتعرف على شكله، مع اسمه بالعربي زي ما بيتقال في المشاتل (زي البوتس، جلد النمر، فيكس نيتيدا، الجارونيا، الفل، الهبسكس، شجرة الفلوس، السيلوم، بتونسيا / بنت القنصل).
+
+2) دكتور النباتات
+لو الورق أصفر أو في تساقط أو عفن، الأداة بتسألك سؤال سؤال وتوصلّك للسبب المحتمل والتصرف المناسب — من غير جدول ري أعمى كل كذا يوم.
+
+3) أداة اختيار النبات
+قبل ما تشتري، تعرف إيه النبات اللي يناسب ضوء بيتك، البلكونة، الأطفال أو الحيوانات.
+
+4) أسقي دلوقتي ولا لأ؟
+الري حسب حالة التربة والنبات والجو، مش حسب روزنامة ثابتة.
+
+5) خلطة التربة
+نِسَب جاهزة بمواد موجودة في المشاتل المصرية: بيتموس، بيرلايت، رمل، تربة زراعية، تربة أصص، كمبوست / سماد عضوي، بيت جوز هند، وفحم نباتي.
+
+6) أحط النبات فين؟ + تعريف الآفات + إنقاذ سريع
+خطوات واضحة لو النبات اتنقل، أو ظهرت حشرة، أو حالته بتسوء.
+
+7) بطاقات العناية + مخطط للطباعة
+تقدر تطبع بطاقة لكل نبات ومخطط أسبوعي وتعلّقهم جنب الأصص.
+
+💡 أفضل طريقة تبدأ بيها:
+
+افتح لينك الدليل.
+لو عندك نبات: ادخل دليل النباتات ودور باسمه.
+لو النبات تعبان: ابدأ من دكتور النباتات.
+لو لسه هتشتري: استخدم أداة النبات المناسب.
+لو مش عارف تسقي: افتح أداة الري.
+لو هتغير تربة: افتح خلطة التربة.
+
+⚠️ مهم:
+الدليل مش بيعمل حساب ولا اشتراك ولا متابعة سحابية. القيمة في الأدوات والمحتوى والطباعة.
+
+💬 لو واجهتك أي مشكلة في الدخول أو الاستخدام، ابعتلي على واتساب:
+
+${whatsapp}
+
+أتمنى الدليل يوفّر عليك تخمين و tappering غلط، ويخليك تتعرف على نباتك وتعالجه صح. 🤍
+
+بالتوفيق،
+محمود القوصي`;
