+  const htmlBody = escapeHtml(text)
+    .replaceAll("\n\n", "</p><p>")
+    .replaceAll("\n", "<br/>");
+
+  const htmlLinked = link
+    ? htmlBody.replace(
+        escapeHtml(link),
+        `<a href="${escapeHtml(link)}" style="color:#3d6b4c;font-weight:800" target="_blank" rel="noreferrer">${escapeHtml(link)}</a>`
+      )
+    : htmlBody;
+
+  const html = `<!doctype html>
+<html lang="ar" dir="rtl">
+  <body style="margin:0;padding:24px;background:#f6f1e8;">
+    <div style="max-width:640px;margin:0 auto;background:#fffdf8;border-radius:18px;padding:28px;font-family:Tahoma,Arial,sans-serif;line-height:1.9;color:#2c3a2e;font-size:16px;">
+      <p>${htmlLinked}</p>
+    </div>
+  </body>
+</html>`;
+
+  return {
+    subject: PLANT_PURCHASE_EMAIL_SUBJECT,
+    text,
+    html,
+  };
+}
+
+function escapeHtml(value: string) {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
